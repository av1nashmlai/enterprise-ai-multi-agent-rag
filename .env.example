# =====================================================================
# MULTI-PROVIDER API CONFIGURATION (Edureka_Capstone_Project)
# Paste your active API key below (NVIDIA NIM, OpenRouter, Groq, Gemini, or OpenAI).
# Note: Entering a key in the Streamlit sidebar also saves it here automatically!
# =====================================================================

# Option 1: NVIDIA NIM (Key starts with nvapi-)
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"

# Option 2: OpenRouter (Key starts with sk-or-)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Option 3: Groq Cloud (Key starts with gsk_)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Option 4: Google Gemini (Key starts with AIza)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Option 5: OpenAI (Key starts with sk-)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Embedding Engine Mode: "auto" (uses provider embeddings or local ONNX) or "local" (100% free local ONNX)
EMBEDDING_PROVIDER="auto"

# Vector Database Settings
CHROMA_PERSIST_DIR="./vector_db"
COLLECTION_NAME="enterprise_knowledge_base"
